# Root allowlist: unrelated workspace folders and personal files stay private.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/.github/
!/.release-files.json
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/backend/
!/contracts/
!/docs/
!/evaluation/
!/fixtures/
!/public/
!/src/
!/tests/
!/tools/
!/index.html
!/package.json
!/package-lock.json
!/pytest.ini
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/vite.config.ts

node_modules/
dist/
.vite/
.env
.env.*
private-data/
runtime-data/
*.local
.venv/
__pycache__/
.pytest_cache/
*.pyc
private-benchmarks/
private-reports/
!.env.example

# Release staging and career materials are not application source.
tmp/
.publish/
/docs/*INTERVIEW*

# Never commit local authentication/configuration or personal source documents.
.codex/
.agents/
.ssh/
.aws/
.azure/
.config/
.netrc
.npmrc
auth.json
credentials.json
*credentials*.json
*.key
*.pem
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.log
*.txt
*.TXT
!backend/requirements.txt
*.docx
*.pdf
*.pptx
*.xlsx
!public/demo-memo.xlsx
